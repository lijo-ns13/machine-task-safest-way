# Copy to .env and fill in. See README for how to get a Mapbox token (free).
MAPBOX_TOKEN=pk.your_mapbox_public_token
# Optional: restrict place search to countries (ISO codes), e.g. us or in,us. Empty = worldwide.
GEOCODING_COUNTRY=
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173
